# Set these only in Vercel/server hosting. Never commit a real .env file.
# Do not expose server-only values in a VITE_* variable or client-side script.

# Existing AI rate-limit configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required when implementing protected video access on the streaming server.
# The stream server must validate Firebase ID tokens and issue short-lived
# signed media URLs. These values must never be sent to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STREAM_SIGNING_SECRET=
STREAM_ORIGIN=https://stream.codextrms.in
